project Vektor is
   type Build_Mode_Type is ("debug", "release");
   Build_Mode : Build_Mode_Type := external ("VEKTOR_BUILD", "release");

   for Source_Dirs use ("src", "src/lang", "src/lang/vm", "src/lang/vm/core", "src/lang/vm/ir", "src/lang/vm/runtime", "backend");
   for Object_Dir use "obj";

   package Compiler is
      case Build_Mode is
         when "debug" =>
            for Default_Switches ("Ada") use ("-g", "-O1", "-gnata", "-gnato", "-gnatwa", "-gnatVa");
         when "release" =>
            for Default_Switches ("Ada") use ("-O3", "-gnatp", "-gnatn");
      end case;
   end Compiler;
end Vektor;
